{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "composite": true,
    "outDir": "./dist-ts/test",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["tests", "electron", "shared", "src/store", "src/models", "src/utils", "src/services", "src/types", "src/components/libroDesdeLibroForm.ts", "src/components/libroDesdeMarc21Form.ts"]
}